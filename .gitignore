# Her job search data never belongs in the repo: postings, rejections,
# salary expectations, application evidence. This line is load-bearing.
data/
logs/

# HER PERSONAL DATA. THIS REPOSITORY IS PUBLIC.
# A CV carries full name, address, phone, email and employment history.
# Everything in profile/ is ignored except the two committed templates, and
# scripts/githooks/pre-push refuses to push if anything else here gets tracked.
profile/*
!profile/README.md
!profile/preferences.example.yaml

# Local pause switch
PAUSED

# Generated per-machine by `verify-companies --write`
config/companies.verified.yaml

# Her own watchlist additions, written by the Companies screen. Must stay
# untracked: if git tracked it, editing it would leave her repo dirty, the
# `git pull --ff-only` in run_harvest.sh would refuse, and auto-update would
# silently stop on a machine nobody is watching.
config/companies.local.yaml
config/settings.local.yaml

.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
