#!/usr/bin/env bash
# Blocks a push that would break the machine this runs on unattended.
#
# There is no CI gate. Whatever lands on master executes on her laptop within the
# hour, with nobody watching. GitHub Actions re-runs these same checks after the
# fact, but this hook is what stops a bad push from ever leaving.
#
# Enable once:  git config core.hooksPath scripts/githooks
# scripts/setup_dev.sh and scripts/setup_mac.sh both do this for you.
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO" || exit 1

fail() { printf '\n\033[31mpush blocked:\033[0m %s\n\n' "$*" >&2; exit 1; }

# --- 1. shell scripts must parse ----------------------------------------------
# This check matters more than the tests. Broken Python still self-heals: the
# next scheduled run pulls the fix before executing it. A broken run_harvest.sh
# does NOT - bash dies before reaching the git pull, so the machine is stuck
# until someone physically touches it.
for f in scripts/*.sh scripts/githooks/*; do
  [[ -f "$f" ]] || continue
  bash -n "$f" 2>/dev/null || fail "$f has a syntax error. This would strand her Mac with no way to self-update."
done

# --- 2. no personal data may ever be pushed -----------------------------------
# The repository is public. A CV carries full name, address, phone and
# employment history, and a push is not undoable - even a reverted commit stays
# in the history and in anyone's clone. .gitignore is the first line of defence;
# this is the one that catches `git add -f` and a stray copy saved elsewhere.
LEAKED="$(git ls-files \
  | grep -Ev '^profile/(README\.md|preferences\.example\.yaml)$' \
  | grep -Ei '^profile/|resume|cv[-_.]|curriculum.?vitae|\.docx?$|\.pdf$' || true)"

if [[ -n "$LEAKED" ]]; then
  printf '\n\033[31mpush blocked:\033[0m these look like personal files and this repo is PUBLIC:\n\n' >&2
  printf '    %s\n' $LEAKED >&2
  printf '\n  Remove them from git before pushing (the file stays on disk):\n' >&2
  printf '      git rm --cached <file>\n\n' >&2
  exit 1
fi

# --- 3. tests must pass -------------------------------------------------------
# The venv comes FIRST. The tests import httpx, yaml and playwright, and pytest
# itself is only in requirements-dev.txt - none of which a Mac's system python3
# has. Picking the system interpreter turns every push into a wall of
# ModuleNotFoundError that reads like "your tests are broken" when nothing is
# wrong with them at all.
PY=""
for c in "$REPO/.venv/bin/python" "$REPO/.venv/Scripts/python.exe" python3 python; do
  if [[ -x "$c" ]] || command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done
[[ -n "$PY" ]] || fail "no python found to run the tests. Run ./scripts/setup_dev.sh first."

# Distinguish "pytest isn't installed" from "the tests fail". They need
# completely different responses and the raw output does not make that obvious.
if ! "$PY" -c 'import pytest' >/dev/null 2>&1; then
  fail "$PY has no pytest, so the tests cannot run.
  Run ./scripts/setup_dev.sh in this folder, then push again."
fi

if ! "$PY" -m pytest tests/ -q >/tmp/meester_pretest.log 2>&1; then
  tail -25 /tmp/meester_pretest.log >&2
  fail "tests are failing. Fix them or push with --no-verify if you are certain."
fi

printf '\033[32mpre-push ok:\033[0m scripts parse, tests pass\n'
exit 0
